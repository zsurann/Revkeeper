# Intestazioni di sicurezza. Lo stile inline serve al cruscotto (lancetta e barre).
# Restano consentiti: Google Identity Services, le foto e i PDF in blob:, il service worker e le notifiche.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), notifications=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; font-src 'self' data:; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com blob:; worker-src 'self'; manifest-src 'self'; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
