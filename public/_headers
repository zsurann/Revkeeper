# Intestazioni di sicurezza. Lo stile inline serve al cruscotto (lancetta e barre).
# Restano consentiti: Google Identity Services, le foto e i PDF in blob:, il service worker, le notifiche
# (non serve una voce in Permissions-Policy: "notifications" non esiste e Chrome la segnala in console)
# l'invio degli errori a Sentry (connect-src) e le statistiche anonime di Cloudflare Web Analytics
# (senza cookie: script da static.cloudflareinsights.com, invio a cloudflareinsights.com).
/*
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; font-src 'self' data:; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' https://accounts.google.com https://o4512444032352256.ingest.de.sentry.io https://cloudflareinsights.com; frame-src https://accounts.google.com blob:; worker-src 'self'; manifest-src 'self'; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# File con l'impronta nel nome: non cambiano mai, il telefono li tiene un anno senza richiederli
/assets/*
  Cache-Control: public, max-age=31536000, immutable
